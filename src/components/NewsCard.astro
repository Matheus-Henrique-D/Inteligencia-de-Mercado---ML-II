---
import type { NewsItem } from '../types/content';
import { getNewsUrl } from '../lib/urls';
import { formatTime, formatDate } from '../lib/formatting';

interface Props {
  item: NewsItem;
  featured?: boolean;
}

const { item } = Astro.props;
const newsUrl = getNewsUrl(item.slug);
const formattedDate = formatDate(item.published_at);
const formattedTime = formatTime(item.published_at);

// Curated category fallback images for agro topics
const categoryImages: Record<string, string> = {
  mercado: 'https://images.unsplash.com/photo-1611974789855-9c2a0a7236a3?auto=format&fit=crop&w=800&q=80',
  clima: 'https://images.unsplash.com/photo-1534088568595-a066f410bcda?auto=format&fit=crop&w=800&q=80',
  tecnologia: 'https://images.unsplash.com/photo-1586771107445-d3ca888129ff?auto=format&fit=crop&w=800&q=80',
  agricultura: 'https://images.unsplash.com/photo-1500937386664-56d1dfef3854?auto=format&fit=crop&w=800&q=80',
  pecuaria: 'https://images.unsplash.com/photo-1570042225831-d98fa7577f1e?auto=format&fit=crop&w=800&q=80',
  politica: 'https://images.unsplash.com/photo-1541872703-74c5e44368f9?auto=format&fit=crop&w=800&q=80',
  sustentabilidade: 'https://images.unsplash.com/photo-1473448912268-2022ce9509d8?auto=format&fit=crop&w=800&q=80',
  internacional: 'https://images.unsplash.com/photo-1526778548025-fa2f459cd5c1?auto=format&fit=crop&w=800&q=80',
};

const coverImage = item.heroImage || categoryImages[item.category.toLowerCase()] || 'https://images.unsplash.com/photo-1500937386664-56d1dfef3854?auto=format&fit=crop&w=800&q=80';
const newsTitle = item.title;
---

<a href={newsUrl} class="the-news-card" aria-label={newsTitle}>
  <div class="the-news-card-media">
    <img
      src={coverImage}
      alt={item.heroAlt || item.title}
      class="the-news-card-img"
      loading="lazy"
    />
    <div class="the-news-badge-overlay">
      <span>{item.category.toUpperCase()}</span>
    </div>
  </div>

  <div class="the-news-card-body">
    <span class="the-news-card-time">{formattedTime} &middot; {formattedDate}</span>
    <h3 class="the-news-card-title">{item.title}</h3>
    <p class="the-news-card-sub">{item.summary}</p>
    <div class="the-news-card-footer">
      <span>🌱 the agro news</span>
      {item.source && <span style="margin-left: auto; font-weight: 500; color: var(--color-text-muted); font-size: 0.7rem;">via {item.source.name}</span>}
    </div>
  </div>
</a>
