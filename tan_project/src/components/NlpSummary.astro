---
import type { NlpData } from '../types/content';

interface Props {
  nlp?: NlpData;
}

const { nlp } = Astro.props;
if (!nlp || !nlp.tan_summary) return null;
---

<div class="tan-summary-box">
  <div class="tan-summary-header">
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
    </svg>
    <span>Resumo TAN (NLP)</span>
  </div>
  <p class="tan-summary-text">
    {nlp.tan_summary}
  </p>
</div>
